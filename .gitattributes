# Auto detect text files and perform LF normalization
* text=auto

# C++ Source Files
*.c     text diff=c
*.cc    text diff=cpp
*.cxx   text diff=cpp
*.cpp   text diff=cpp
*.c++   text diff=cpp
*.hpp   text diff=cpp
*.h     text diff=cpp
*.h++   text diff=cpp
*.hh    text diff=cpp

# The ffmpeg overlay port keeps LF in every checkout: its build.sh.in runs in bash, and vcpkg hashes the port files
vcpkg-overlay-ports/ffmpeg/** text eol=lf

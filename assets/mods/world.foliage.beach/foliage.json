// foliage.json (antes foliage.cfg; tools/mod_cfg_to_json.py): cada {"section": "<nombre>", clave: valor...} de "rules" es
// una sección [<nombre>] del formato antiguo; las listas van como ["a", "b"]. Mods/RuleFiles.h lo lee.
// Módulo "Beach" de world.foliage: cosas tumbadas en la arena de la playa.
// Mismas claves que Mods/world.foliage/foliage.cfg, y además:
// flat  = on: la imagen va pegada al suelo (inclinada con él), mezclada por su alfa, en vez de de pie
// coast = on: también en las celdas de costa y junto al agua (la altitude las deja fuera del agua)
// lift  = altura sobre el suelo de las planas (0.04 por defecto)
// share = parte mínima (0-1) del suelo dibujado en ese punto que es de sus texturas (las cuatro esquinas de la celda
// por su peso y la mezcla de los dos materiales de cada una): 0,8 = solo donde casi todo es arena
// shade = con tint all/grey, cuánto del color del suelo toma (menos de 1 = más oscuro: arena mojada)
// opacity = 0-1: las planas se mezclan con esta opacidad (1 por defecto)
// La densidad del módulo (su opción Density en el menú de mods, del mod.cfg) multiplica todos los per_cell, igual que
// la densidad del mod: very low 0,25, low 0,5, medium 1, high 2, very high 4.
// Imágenes del usuario (B&W/Asstes_mods/Beach), vistas desde arriba; con flat el alto de la imagen va a lo largo
// del suelo y size es su ancho. tint = none: sus propios colores.
// La orilla: el suelo dibujado de las celdas coastLine está a 1,34 (alfa 0,5) y el de las celdas con agua a 0-0,67
// (transparente, se ve el mar); la tierra opaca empieza en 2,01. near = sea mide desde las esquinas de las celdas con
// agua: la orilla visible queda a 6-10 unidades. Medido en Land1-5 (dev/tmp_dis/heights).
//
// Dos franjas: la orilla (water_distance hasta ~20: algas, arena mojada, estrellas, conchas), poco cargada, y la
// arena seca de detrás (desde ~18 hasta 80: conchas, caracolas, piedras, algas secas, coral y huellas); share = 0.8
// las deja solo donde el suelo es casi todo arena.
//
// --- la orilla ---
//
// algas que ha dejado la marea, junto al agua
{
  "schema": 1,
  "rules": [
    {
      "section": "seaweed",
      "images": ["beach_alge_1.png", "beach_alge_3.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "coast": "on",
      "near": ["sea"],
      "water_distance": "7-16",
      "altitude": "1.1-2",
      "slope": "0-25",
      "per_cell": 0.18,
      "size": "1.2-2.1",
      "patches": 0.4,
      "share": 0.8,
      "tint": "none"
    },
    // arena mojada, más oscura, junto a la orilla (en la franja de costa el suelo es medio transparente y la mancha
    // parecería flotar sobre el agua: empieza donde el suelo ya es casi opaco)
    {
      "section": "wet_sand",
      "images": ["beach_footprint_3.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "coast": "on",
      "near": ["sea"],
      "water_distance": "5-14",
      "altitude": "1.5-2.3",
      "slope": "0-20",
      "per_cell": 0.12,
      "size": "2.5-4.5",
      "patches": 0.3,
      "lift": 0.02,
      "share": 0.8,
      "ground_value": "0.45-1",
      "shade": 0.8,
      "opacity": 0.6,
      "tint": "all"
    },
    {
      "section": "starfish",
      "images": ["beach_deco_5.png", "beach_deco_6.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "coast": "on",
      "near": ["sea"],
      "water_distance": "8-18",
      "altitude": "1.2-2.2",
      "slope": "0-20",
      "per_cell": 0.07,
      "size": "0.6-1.0",
      "patches": 0.3,
      "share": 0.8,
      "tint": "none"
    },
    // conchas sueltas que trae el agua
    {
      "section": "shells",
      "images": ["beach_deco_1.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "coast": "on",
      "near": ["sea"],
      "water_distance": "9-20",
      "altitude": "1.3-3",
      "slope": "0-25",
      "per_cell": 0.2,
      "size": "0.6-1.0",
      "patches": 0.2,
      "share": 0.8,
      "tint": "none"
    },
    // --- la arena seca ---
    {
      "section": "sand_shells",
      "images": ["beach_deco_1.png", "beach_deco_4.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "near": ["sea"],
      "water_distance": "16-80",
      "altitude": "1.5-40",
      "slope": "0-30",
      "per_cell": 1.1,
      "size": "0.6-1.05",
      "patches": 0.35,
      "share": 0.7,
      "tint": "none"
    },
    {
      "section": "sand_pebbles",
      "images": ["beach_deco_2.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "near": ["sea"],
      "water_distance": "16-80",
      "altitude": "1.5-40",
      "slope": "0-35",
      "per_cell": 0.6,
      "size": "0.7-1.2",
      "patches": 0.5,
      "share": 0.7,
      "tint": "none"
    },
    // algas que se secaron donde llegó la marea alta
    {
      "section": "sand_dry_seaweed",
      "images": ["beach_alge_2.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "near": ["sea"],
      "water_distance": "18-45",
      "altitude": "1.5-20",
      "slope": "0-25",
      "per_cell": 0.18,
      "size": "1.0-1.8",
      "patches": 0.5,
      "share": 0.7,
      "tint": "none"
    },
    // trozos de coral, pocos
    {
      "section": "coral",
      "images": ["beach_deco_3.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "near": ["sea"],
      "water_distance": "14-60",
      "altitude": "1.5-30",
      "slope": "0-20",
      "per_cell": 0.05,
      "size": "0.8-1.2",
      "share": 0.7,
      "tint": "none"
    },
    // huellas de pájaros y cangrejos: solo en la arena seca, lejos de la orilla, medio transparentes
    {
      "section": "tracks",
      "images": ["beach_footprint_1.png", "beach_footprint_2.png"],
      "texture": ["sand"],
      "terrain": ["Sand", "WetSand"],
      "flat": "on",
      "near": ["sea"],
      "water_distance": "20-80",
      "altitude": "2-40",
      "slope": "0-20",
      "per_cell": 0.15,
      "size": "2.1-3.4",
      "lift": 0.03,
      "share": 0.7,
      "ground_value": "0.45-1",
      "shade": 0.8,
      "opacity": 0.45,
      "tint": "all"
    }
  ]
}
